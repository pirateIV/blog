# Copy to .env.local and adjust. All values are optional:
# without them the studio works with sensible defaults.

# Password for the author studio (/author, /dashboard and the API routes).
# Unset = open in development, refused in production.
STUDIO_PASSWORD=

# Optional: lets scripts publish without a browser session
# (send it as the x-publish-token header to POST /api/publish).
PUBLISH_TOKEN=
