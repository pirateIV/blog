# Copy to .env.local and adjust. All values are optional:
# without them the studio works with sensible defaults.

# Public site origin — used as metadataBase for canonical/OG URLs, the
# sitemap and the RSS feed. Defaults to the template demo URL; set this to
# your own domain in production.
NEXT_PUBLIC_SITE_URL=

# Password for the author studio (/studio, /dashboard and the API routes).
# Unset = open in development, refused in production.
# REQUIRED in production (Vercel → Settings → Environment Variables),
# or the studio login stays locked.
#
# This is the *default* you hand to the author — they can replace it from
# the studio (stored hashed in .studio/auth.json, see README). Keep it set:
# it also peppers that hash and signs session cookies. To reset a changed
# password, delete .studio/auth.json (locally and/or in the repo).
STUDIO_PASSWORD=

# Optional: lets scripts publish without a browser session
# (send it as the x-publish-token header to POST /api/publish).
PUBLISH_TOKEN=

# --- Publishing storage -------------------------------------------------
# Development (and any host with a writable disk) writes posts straight
# into content/ and public/images/uploads/ — no configuration needed.
#
# On an immutable host (Vercel) the filesystem is read-only, so the same
# endpoints commit through the GitHub Contents API instead. Each publish,
# unpublish or upload is a commit; the push triggers a redeploy, so the
# change goes live about a minute later. Without these vars, production
# answers 503 on the write endpoints (reads keep working).
#
# Fine-grained PAT for THIS repository only, "Contents: Read and write".
# Keep it server-side — never expose it with a NEXT_PUBLIC_ prefix.
GITHUB_REPO=your-name/your-repo
GITHUB_TOKEN=

# Optional overrides:
#   GITHUB_BRANCH=main    # branch to commit to (default: main)
#   GITHUB_API_URL=...    # GitHub Enterprise, or a test double
#   STUDIO_STORAGE=fs     # force plain files (VPS with a writable disk);
#                         # STUDIO_STORAGE=github forces commits instead
